{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "postgres": {
      "type": "container.v0",
      "connectionString": "Host={postgres.bindings.tcp.host};Port={postgres.bindings.tcp.port};Username=postgres;Password={postgres-password.value}",
      "image": "docker.io/postgres:16-alpine",
      "volumes": [
        {
          "name": "careeros.apphost-23454d9d39-postgres-data",
          "target": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "CareerDatabase": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=careeros"
    },
    "openbao": {
      "type": "container.v0",
      "image": "openbao/openbao:latest",
      "volumes": [
        {
          "name": "openbao_data",
          "target": "/openbao/data",
          "readOnly": false
        }
      ],
      "env": {
        "BAO_DEV_ROOT_TOKEN_ID": "root",
        "BAO_DEV_LISTEN_ADDRESS": "0.0.0.0:8200",
        "VAULT_DEV_ROOT_TOKEN_ID": "root",
        "VAULT_DEV_LISTEN_ADDRESS": "0.0.0.0:8200"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8200
        }
      }
    },
    "careeros-api": {
      "type": "project.v0",
      "path": "../backend/CareerOS.Api/CareerOS.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{careeros-api.bindings.http.targetPort}",
        "ConnectionStrings__CareerDatabase": "{CareerDatabase.connectionString}",
        "OpenBao__Enabled": "true",
        "BAO_ADDR": "{openbao.bindings.http.url}",
        "OpenBao__Address": "{openbao.bindings.http.url}",
        "JwtOptions__SecretKey": "9bf0a6bfb77ea9f87f72791ef41137ed"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "careeros-frontend": {
      "type": "executable.v0",
      "workingDirectory": "../frontend",
      "command": "npm",
      "args": [
        "run",
        "start"
      ],
      "env": {
        "NODE_ENV": "production",
        "services__careeros-api__http__0": "{careeros-api.bindings.http.url}",
        "services__careeros-api__https__0": "{careeros-api.bindings.https.url}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 4200
        }
      }
    },
    "postgres-password": {
      "type": "parameter.v0",
      "value": "{postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    }
  }
}